# BacAtlas — Docker Compose configuration. Copy to `.env` (which git ignores) and fill in.
#
# ⛔ These are the HOST-side names that `compose.yaml` reads, and they are deliberately not the
# containers' own (`SYNTITUDE_DATABASE_URL`, `SYNTITUDE_ROOT_GFF`): Compose lets the invoking shell
# override `.env`, and the Mac development setup sets those two names in the shell, pointing at
# localhost and at a Mac path. `compose.yaml` builds the container-side values from the ones below.

# ── database ─────────────────────────────────────────────────────────────────────────────────────
# REQUIRED. ⚠ It is spliced into a database URL, so keep it URL-safe — `openssl rand -hex 24`.
# A `@`, `/`, `:` or `#` in it breaks the URL, and the api then fails at start-up.
SYNTITUDE_DB_PASSWORD=
SYNTITUDE_DB_USER=syntitude
SYNTITUDE_DB_NAME=syntitude

# A host DIRECTORY holding `bacatlas.dump` (from `pg_dump -Fc`). Restored on the FIRST start
# against an empty volume only; with no dump there, the database starts empty. Path relative to
# this file, or absolute.
SYNTITUDE_HOST_DUMP_DIR=./deploy/dump
# Parallel `pg_restore` jobs. Roughly the VM's cores.
SYNTITUDE_RESTORE_JOBS=4

# ── annotation store (the Sequence tab) ──────────────────────────────────────────────────────────
# The host directory of gzipped Bakta GFFs, mounted READ-ONLY into the api. Leave EMPTY to run
# without it: the sequence endpoint then answers 503 "no annotation store configured" and nothing
# else is affected. ⚠ On Linux the tree must be readable by uid 10001, the api's user.
SYNTITUDE_HOST_GFF_DIR=

# ── api ──────────────────────────────────────────────────────────────────────────────────────────
# gunicorn worker processes (sync). Each holds at most one database connection at a time.
SYNTITUDE_API_WORKERS=4

# ── web ──────────────────────────────────────────────────────────────────────────────────────────
# Where the app is served from: `/`, or a subpath such as `/bacatlas/` (both slashes required).
# ⛔ Fixed at BUILD time — it is compiled into the bundle — so changing it needs
# `docker compose build web`, not just a restart.
SYNTITUDE_PUBLIC_BASE=/
# Where the browser finds the API. Leave EMPTY for "under the app's own base"
# (`${SYNTITUDE_PUBLIC_BASE}api/v1`), which nginx proxies to the api. Set it only when the API is
# served from another origin. Also build-time.
SYNTITUDE_API_BASE_URL=
# The published address. 127.0.0.1 keeps it on this machine; set 0.0.0.0 when a reverse proxy on
# ANOTHER host has to reach it.
SYNTITUDE_HTTP_BIND=127.0.0.1
SYNTITUDE_HTTP_PORT=8080
